+    /**
+     * Run batched file processing using proc_open instead of pcntl_fork.
+     *
+     * Used on Windows and any other platform where the PCNTL extension is
+     * unavailable. Each batch re-invokes the same phpcs entry script with a
+     * sliced file list and --report=json, then merges the JSON output back
+     * into the parent Reporter so the configured reports include every
+     * violation reported by the children.
+     *
+     * @param \PHP_CodeSniffer\Files\FileList $todo     The full file list.
+     * @param int                             $numFiles Total non-ignored file count for progress display.
+     *
+     * @return bool True when every child exited with a phpcs-compatible status code.
+     */
+    private function runWindowsParallel($todo, $numFiles)
+    {
+        $paths = [];
+        foreach ($todo as $path => $file) {
+            if ($file->ignored === false) {
+                $paths[] = $path;
+            }
+        }
+
+        $numFiles = count($paths);
+        if ($numFiles === 0) {
+            return true;
+        }
+
+        $parallel    = max(1, (int) $this->config->parallel);
+        $numPerBatch = (int) ceil($numFiles / $parallel);
+
+        $script = '';
+        if (isset($_SERVER['SCRIPT_FILENAME']) === true && is_string($_SERVER['SCRIPT_FILENAME']) === true) {
+            $script = $_SERVER['SCRIPT_FILENAME'];
+        }
+
+        if ($script === '' || file_exists($script) === false) {
+            // Cannot locate the phpcs entry script - fall back to serial.
+            $numProcessed = 0;
+            foreach ($paths as $path) {
+                $file = $todo[$path];
+                $this->processFile($file);
+                $numProcessed++;
+                $this->printProgress($file, $numFiles, $numProcessed);
+            }
+
+            return true;
+        }
+
+        $childArgs    = $this->buildWindowsChildArgs();
+        $cacheEnabled = ($this->config->cache === true);
+        $parentCache  = $cacheEnabled === true ? $this->readParentCacheFile() : null;
+
+        $children     = [];
+        $totalBatches = 0;
+        for ($batch = 0; $batch < $parallel; $batch++) {
+            $startAt = ($batch * $numPerBatch);
+            if ($startAt >= $numFiles) {
+                break;
+            }
+
+            $slice = array_slice($paths, $startAt, $numPerBatch);
+            if (count($slice) === 0) {
+                continue;
+            }
+
+            $outFile        = tempnam(sys_get_temp_dir(), 'phpcs-child-');
+            $errFile        = tempnam(sys_get_temp_dir(), 'phpcs-err-');
+            $listFile       = tempnam(sys_get_temp_dir(), 'phpcs-list-');
+            file_put_contents($listFile, implode("\n", $slice));
+
+            $childCacheFile = null;
+            $cacheArgs      = ['--no-cache'];
+            if ($cacheEnabled === true) {
+                $childCacheFile = tempnam(sys_get_temp_dir(), 'phpcs-cache-');
+                if ($parentCache !== null) {
+                    file_put_contents($childCacheFile, $parentCache);
+                }
+
+                $cacheArgs = ['--cache='.$childCacheFile];
+            }
+
+            $cmd = array_merge(
+                [PHP_BINARY, $script],
+                $childArgs,
+                ['--parallel=1', '-q', '--report=json', '--report-file='.$outFile, '--file-list='.$listFile],
+                $cacheArgs
+            );
+
+            // Redirect child stdout/stderr to files rather than pipes. Pipe
+            // buffers fill up on Windows when a child writes more than the OS
+            // buffer size, which deadlocks both the child (blocked on write)
+            // and the parent (blocked waiting for exit). Files never block.
+            $proc = proc_open(
+                $cmd,
+                [
+                    0 => ['pipe', 'r'],
+                    1 => ['file', $outFile.'.stdout', 'w'],
+                    2 => ['file', $errFile, 'w'],
+                ],
+                $pipes
+            );
+
+            if (is_resource($proc) === false) {
+                @unlink($outFile);
+                @unlink($errFile);
+                @unlink($listFile);
+                if ($childCacheFile !== null) {
+                    @unlink($childCacheFile);
+                }
+
+                return false;
+            }
+
+            if (isset($pipes[0]) === true && is_resource($pipes[0]) === true) {
+                fclose($pipes[0]);
+            }
+
+            $children[]    = [
+                'proc'      => $proc,
+                'outFile'   => $outFile,
+                'errFile'   => $errFile,
+                'listFile'  => $listFile,
+                'cacheFile' => $childCacheFile,
+                'files'     => $slice,
+                'started'   => microtime(true),
+                'elapsed'   => 0.0,
+            ];
+            $totalBatches++;
+        }
+
+        $success      = true;
+        $numProcessed = 0;
+        $pending      = $children;
+
+        while (count($pending) > 0) {
+            $finishedKey = null;
+            foreach ($pending as $key => $child) {
+                $status = proc_get_status($child['proc']);
+                if ($status === false || $status['running'] === false) {
+                    $children[$key]['elapsed'] = (microtime(true) - $child['started']);
+                    $finishedKey = $key;
+                    break;
+                }
+            }
+
+            if ($finishedKey === null) {
+                usleep(10000);
+                continue;
+            }
+
+            $finishedChild = $pending[$finishedKey];
+            unset($pending[$finishedKey]);
+
+            $exit = proc_close($finishedChild['proc']);
+
+            $fileCounts = [];
+            if (file_exists($finishedChild['outFile']) === true) {
+                $raw = file_get_contents($finishedChild['outFile']);
+                @unlink($finishedChild['outFile']);
+                $json = ($raw === false || $raw === '') ? null : json_decode($raw, true);
+                if (is_array($json) === true) {
+                    $this->mergeChildJsonReport($json);
+                    if (isset($json['files']) === true && is_array($json['files']) === true) {
+                        foreach ($json['files'] as $reportPath => $info) {
+                            if (is_array($info) === true) {
+                                $fileCounts[$reportPath] = [
+                                    'errors'   => (isset($info['errors']) === true ? (int) $info['errors'] : 0),
+                                    'warnings' => (isset($info['warnings']) === true ? (int) $info['warnings'] : 0),
+                                ];
+                            }
+                        }
+                    }
+                }
+            }
+
+            @unlink($finishedChild['outFile'].'.stdout');
+            @unlink($finishedChild['listFile']);
+
+            $stderr = '';
+            if (file_exists($finishedChild['errFile']) === true) {
+                $errRaw = file_get_contents($finishedChild['errFile']);
+                @unlink($finishedChild['errFile']);
+                $stderr = ($errRaw === false) ? '' : $errRaw;
+            }
+
+            if ($finishedChild['cacheFile'] !== null) {
+                if (file_exists($finishedChild['cacheFile']) === true) {
+                    $this->mergeChildCacheFile($finishedChild['cacheFile']);
+                    @unlink($finishedChild['cacheFile']);
+                }
+            }
+
+            // PHPCS exits with 1/2 when violations were found; only treat other codes as failure.
+            if ($exit !== 0 && $exit !== 1 && $exit !== 2) {
+                $success = false;
+                if ($stderr !== '') {
+                    fwrite(STDERR, $stderr);
+                }
+            }
+
+            foreach ($finishedChild['files'] as $filePath) {
+                $numProcessed++;
+
+                $errors   = 0;
+                $warnings = 0;
+                if (isset($fileCounts[$filePath]) === true) {
+                    $errors   = $fileCounts[$filePath]['errors'];
+                    $warnings = $fileCounts[$filePath]['warnings'];
+                } else {
+                    $base = basename($filePath);
+                    foreach ($fileCounts as $reportPath => $counts) {
+                        if (basename($reportPath) === $base) {
+                            $errors   = $counts['errors'];
+                            $warnings = $counts['warnings'];
+                            break;
+                        }
+                    }
+                }
+
+                $progressFile = new DummyFile($filePath, $this->ruleset, $this->config);
+                $progressFile->setErrorCounts($errors, $warnings, 0, 0);
+                $this->printProgress($progressFile, $numFiles, $numProcessed);
+            }
+        }
+
+        $this->reportSlowestBatches($children);
+
+        return $success;
+
+    }//end runWindowsParallel()
+
+
+    /**
+     * Print the slowest N parallel batches to STDERR for diagnostics.
+     *
+     * Enable by setting the PHPCS_BATCH_TIMING environment variable to a
+     * truthy value before invoking phpcs. Optionally override the number of
+     * batches reported via PHPCS_BATCH_TIMING_TOP (default 7).
+     *
+     * @param array<int, array<string, mixed>> $children Completed child batch records.
+     *
+     * @return void
+     */
+    private function reportSlowestBatches(array $children)
+    {
+        $flag = getenv('PHPCS_BATCH_TIMING');
+        if ($flag === false || $flag === '' || $flag === '0') {
+            return;
+        }
+
+        $top = (int) getenv('PHPCS_BATCH_TIMING_TOP');
+        if ($top <= 0) {
+            $top = 7;
+        }
+
+        usort(
+            $children,
+            function ($a, $b) {
+                return ($b['elapsed'] <=> $a['elapsed']);
+            }
+        );
+
+        $slice = array_slice($children, 0, $top);
+        fwrite(STDERR, PHP_EOL.sprintf('=== Slowest %d phpcs batches ===', count($slice)).PHP_EOL);
+        foreach ($slice as $rank => $batch) {
+            $elapsed = number_format((float) $batch['elapsed'], 3);
+            $count   = count($batch['files']);
+            fwrite(STDERR, sprintf('#%d  %ss  (%d files)', ($rank + 1), $elapsed, $count).PHP_EOL);
+            foreach ($batch['files'] as $path) {
+                fwrite(STDERR, '    '.$path.PHP_EOL);
+            }
+        }
+
+        fwrite(STDERR, PHP_EOL);
+
+    }//end reportSlowestBatches()
+
+
+    /**
+     * Build the CLI argument list passed to each Windows child process.
+     *
+     * Strips file path positional arguments and any --parallel flag from the
+     * current invocation so the child receives the same flags but operates
+     * only on its assigned slice.
+     *
+     * @return array<int, string>
+     */
+    private function buildWindowsChildArgs()
+    {
+        $argv = [];
+        if (isset($_SERVER['argv']) === true && is_array($_SERVER['argv']) === true) {
+            $argv = $_SERVER['argv'];
+        }
+
+        array_shift($argv);
+        $out = [];
+        foreach ($argv as $arg) {
+            if (is_string($arg) === false || $arg === '') {
+                continue;
+            }
+
+            if (strncmp($arg, '--parallel', 10) === 0) {
+                continue;
+            }
+
+            if (strncmp($arg, '--cache', 7) === 0 || $arg === '--no-cache') {
+                continue;
+            }
+
+            // These are set explicitly per-child; passing the parent's
+            // versions through would conflict and corrupt the JSON report.
+            if (strncmp($arg, '--report', 8) === 0
+                || strncmp($arg, '--file-list', 11) === 0
+                || strncmp($arg, '--stdin-path', 12) === 0
+                || $arg === '-p'
+                || $arg === '--progress'
+            ) {
+                continue;
+            }
+
+            if (strncmp($arg, '-', 1) !== 0 && @file_exists($arg) === true) {
+                continue;
+            }
+
+            $out[] = $arg;
+        }
+
+        return $out;
+
+    }//end buildWindowsChildArgs()
+
+
+    /**
+     * Merge a child JSON report into the parent Reporter.
+     *
+     * Replays each child violation against a DummyFile and routes it through
+     * Reporter::cacheFileReport so every configured report format receives
+     * the data exactly as if the parent had processed the file itself.
+     *
+     * @param array<string, mixed> $json Decoded JSON report from a child phpcs invocation.
+     *
+     * @return void
+     */
+    private function mergeChildJsonReport(array $json)
+    {
+        if (isset($json['files']) === false || is_array($json['files']) === false) {
+            return;
+        }
+
+        foreach ($json['files'] as $path => $info) {
+            if (is_array($info) === false) {
+                continue;
+            }
+
+            // Anonymous DummyFile that exposes the protected addMessage() so
+            // child violations keep their original line and column. addError()
+            // /addWarning() derive the position from a token pointer, so passing
+            // null collapses every violation onto line 1. Mirrors
+            // LocalFile::replayErrors().
+            $dummy = new class('phpcs_input_file: '.(string) $path."\n", $this->ruleset, $this->config) extends DummyFile {
+
+
+                /**
+                 * Replay child-reported violations at their original position.
+                 *
+                 * @param array<int, array<string, mixed>> $messages Decoded JSON report messages for one file.
+                 *
+                 * @return void
+                 */
+                public function replayMessages(array $messages)
+                {
+                    $this->replayingErrors = true;
+                    foreach ($messages as $msg) {
+                        if (is_array($msg) === false) {
+                            continue;
+                        }
+
+                        $type = isset($msg['type']) ? (string) $msg['type'] : 'ERROR';
+                        $this->addMessage(
+                            ($type !== 'WARNING'),
+                            isset($msg['message']) ? (string) $msg['message'] : '',
+                            isset($msg['line']) ? (int) $msg['line'] : 1,
+                            isset($msg['column']) ? (int) $msg['column'] : 1,
+                            (isset($msg['source']) === true && $msg['source'] !== '') ? (string) $msg['source'] : 'Internal.Unknown',
+                            [],
+                            isset($msg['severity']) ? (int) $msg['severity'] : 5,
+                            isset($msg['fixable']) ? (bool) $msg['fixable'] : false
+                        );
+                    }
+
+                    $this->replayingErrors = false;
+
+                }//end replayMessages()
+
+
+            };
+
+            $messages = (isset($info['messages']) === true && is_array($info['messages']) === true) ? $info['messages'] : [];
+            $dummy->replayMessages($messages);
+
+            $this->reporter->cacheFileReport($dummy);
+        }
+
+    }//end mergeChildJsonReport()
+
+
+    /**
+     * Read the parent's resolved cache file contents (raw JSON) if present.
+     *
+     * Each child is seeded with this content so cache hits from previous
+     * runs are preserved across the proc_open boundary. The parent's
+     * \PHP_CodeSniffer\Util\Cache class stores the resolved path in a
+     * private static property, so reflection is required to read it.
+     *
+     * @return string|null Raw cache file contents, or null when no cache file exists.
+     */
+    private function readParentCacheFile()
+    {
+        try {
+            $ref  = new \ReflectionClass(\PHP_CodeSniffer\Util\Cache::class);
+            $prop = $ref->getProperty('path');
+            if (PHP_VERSION_ID < 80100) {
+                $prop->setAccessible(true);
+            }
+
+            $path = (string) $prop->getValue();
+        } catch (\ReflectionException $e) {
+            return null;
+        }
+
+        if ($path === '' || file_exists($path) === false) {
+            return null;
+        }
+
+        $contents = file_get_contents($path);
+        return ($contents === false) ? null : $contents;
+
+    }//end readParentCacheFile()
+
+
+    /**
+     * Merge a child's cache file entries into the parent's in-memory cache.
+     *
+     * The parent's Runner::run() calls Cache::save() once after all batches
+     * complete, so populating the in-memory cache here is sufficient to
+     * persist the merged result.
+     *
+     * @param string $cacheFile Absolute path to the child's per-shard cache file.
+     *
+     * @return void
+     */
+    private function mergeChildCacheFile($cacheFile)
+    {
+        $raw = file_get_contents($cacheFile);
+        if ($raw === false || $raw === '') {
+            return;
+        }
+
+        $data = json_decode($raw, true);
+        if (is_array($data) === false) {
+            return;
+        }
+
+        foreach ($data as $key => $value) {
+            if ($key === 'config') {
+                continue;
+            }
+
+            \PHP_CodeSniffer\Util\Cache::set($key, $value);
+        }
+
+    }//end mergeChildCacheFile()
+
+
 }//end class
