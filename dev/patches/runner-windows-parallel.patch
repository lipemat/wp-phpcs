+    /**
+     * Run batched file processing using proc_open instead of pcntl_fork.
+     *
+     * Used on Windows and any other platform where the PCNTL extension is
+     * unavailable. Each batch re-invokes the same phpcs entry script with a
+     * sliced file list and --report=json, then merges the JSON output back
+     * into the parent Reporter so the configured reports include every
+     * violation reported by the children.
+     *
+     * @param \PHP_CodeSniffer\Files\FileList $todo     The full file list.
+     * @param int                             $numFiles Total non-ignored file count for progress display.
+     *
+     * @return bool True when every child exited with a phpcs-compatible status code.
+     */
+    private function runWindowsParallel($todo, $numFiles)
+    {
+        $paths = [];
+        foreach ($todo as $path => $file) {
+            if ($file->ignored === false) {
+                $paths[] = $path;
+            }
+        }
+
+        $numFiles = count($paths);
+        if ($numFiles === 0) {
+            return true;
+        }
+
+        $parallel    = max(1, (int) $this->config->parallel);
+        $numPerBatch = (int) ceil($numFiles / $parallel);
+
+        $script = '';
+        if (isset($_SERVER['SCRIPT_FILENAME']) === true && is_string($_SERVER['SCRIPT_FILENAME']) === true) {
+            $script = $_SERVER['SCRIPT_FILENAME'];
+        }
+
+        if ($script === '' || file_exists($script) === false) {
+            // Cannot locate the phpcs entry script - fall back to serial.
+            $numProcessed = 0;
+            foreach ($paths as $path) {
+                $file = $todo[$path];
+                $this->processFile($file);
+                $numProcessed++;
+                $this->printProgress($file, $numFiles, $numProcessed);
+            }
+
+            return true;
+        }
+
+        $childArgs    = $this->buildWindowsChildArgs();
+        $cacheEnabled = ($this->config->cache === true);
+        $parentCache  = $cacheEnabled === true ? $this->readParentCacheFile() : null;
+        $isCbf        = (defined('PHP_CODESNIFFER_CBF') === true && PHP_CODESNIFFER_CBF === true);
+
+        $children     = [];
+        $totalBatches = 0;
+        for ($batch = 0; $batch < $parallel; $batch++) {
+            $startAt = ($batch * $numPerBatch);
+            if ($startAt >= $numFiles) {
+                break;
+            }
+
+            $slice = array_slice($paths, $startAt, $numPerBatch);
+            if (count($slice) === 0) {
+                continue;
+            }
+
+            $outFile        = tempnam(sys_get_temp_dir(), 'phpcs-child-');
+            $errFile        = tempnam(sys_get_temp_dir(), 'phpcs-err-');
+            $listFile       = tempnam(sys_get_temp_dir(), 'phpcs-list-');
+            file_put_contents($listFile, implode("\n", $slice));
+
+            $childCacheFile = null;
+            $cacheArgs      = ['--no-cache'];
+            if ($cacheEnabled === true) {
+                $childCacheFile = tempnam(sys_get_temp_dir(), 'phpcs-cache-');
+                if ($parentCache !== null) {
+                    file_put_contents($childCacheFile, $parentCache);
+                }
+
+                $cacheArgs = ['--cache='.$childCacheFile];
+            }
+
+            // PHPCBF forces its own report set, so the JSON report cannot be used.
+            // The child is told where to write its raw Cbf data instead.
+            $childEnv    = null;
+            $reportFlags = ['--report=json', '--report-file='.$outFile];
+            if ($isCbf === true) {
+                $reportFlags = [];
+                $inherited   = getenv();
+                if (is_array($inherited) === false) {
+                    $inherited = [];
+                }
+
+                $inherited[self::CBF_CHILD_REPORT_ENV] = $outFile;
+                $childEnv = $inherited;
+            }
+
+            $cmd = array_merge(
+                [PHP_BINARY, $script],
+                $childArgs,
+                ['--parallel=1', '-q'],
+                $reportFlags,
+                ['--file-list='.$listFile],
+                $cacheArgs
+            );
+
+            // Redirect child stdout/stderr to files rather than pipes. Pipe
+            // buffers fill up on Windows when a child writes more than the OS
+            // buffer size, which deadlocks both the child (blocked on write)
+            // and the parent (blocked waiting for exit). Files never block.
+            $proc = proc_open(
+                $cmd,
+                [
+                    0 => ['pipe', 'r'],
+                    1 => ['file', $outFile.'.stdout', 'w'],
+                    2 => ['file', $errFile, 'w'],
+                ],
+                $pipes,
+                null,
+                $childEnv
+            );
+
+            if (is_resource($proc) === false) {
+                @unlink($outFile);
+                @unlink($errFile);
+                @unlink($listFile);
+                if ($childCacheFile !== null) {
+                    @unlink($childCacheFile);
+                }
+
+                return false;
+            }
+
+            if (isset($pipes[0]) === true && is_resource($pipes[0]) === true) {
+                fclose($pipes[0]);
+            }
+
+            $children[]    = [
+                'proc'      => $proc,
+                'outFile'   => $outFile,
+                'errFile'   => $errFile,
+                'listFile'  => $listFile,
+                'cacheFile' => $childCacheFile,
+                'files'     => $slice,
+                'started'   => microtime(true),
+                'elapsed'   => 0.0,
+            ];
+            $totalBatches++;
+        }
+
+        $success      = true;
+        $numProcessed = 0;
+        $pending      = $children;
+
+        while (count($pending) > 0) {
+            $finishedKey = null;
+            foreach ($pending as $key => $child) {
+                $status = proc_get_status($child['proc']);
+                if ($status === false || $status['running'] === false) {
+                    $children[$key]['elapsed'] = (microtime(true) - $child['started']);
+                    $finishedKey = $key;
+                    break;
+                }
+            }
+
+            if ($finishedKey === null) {
+                usleep(10000);
+                continue;
+            }
+
+            $finishedChild = $pending[$finishedKey];
+            unset($pending[$finishedKey]);
+
+            $exit = proc_close($finishedChild['proc']);
+
+            $fileCounts = [];
+            if (file_exists($finishedChild['outFile']) === true) {
+                $raw = file_get_contents($finishedChild['outFile']);
+                @unlink($finishedChild['outFile']);
+                if ($isCbf === true) {
+                    $fileCounts = $this->mergeChildCbfReport(
+                        ($raw === false) ? '' : $raw,
+                        $finishedChild['outFile'].'.totals',
+                        $finishedChild['files']
+                    );
+                } else {
+                    $json = ($raw === false || $raw === '') ? null : json_decode($raw, true);
+                    if (is_array($json) === true) {
+                        $this->mergeChildJsonReport($json, $finishedChild['files']);
+                        if (isset($json['files']) === true && is_array($json['files']) === true) {
+                            foreach ($json['files'] as $reportPath => $info) {
+                                if (is_array($info) === true) {
+                                    $resolved = $this->resolveChildReportPath((string) $reportPath, $finishedChild['files']);
+                                    $fileCounts[$resolved] = [
+                                        'errors'   => (isset($info['errors']) === true ? (int) $info['errors'] : 0),
+                                        'warnings' => (isset($info['warnings']) === true ? (int) $info['warnings'] : 0),
+                                        'fixable'  => 0,
+                                        'fixed'    => 0,
+                                    ];
+                                }
+                            }
+                        }
+                    }
+                }//end if
+            }//end if
+
+            @unlink($finishedChild['outFile'].'.stdout');
+            @unlink($finishedChild['outFile'].'.totals');
+            @unlink($finishedChild['listFile']);
+
+            $stderr = '';
+            if (file_exists($finishedChild['errFile']) === true) {
+                $errRaw = file_get_contents($finishedChild['errFile']);
+                @unlink($finishedChild['errFile']);
+                $stderr = ($errRaw === false) ? '' : $errRaw;
+            }
+
+            if ($finishedChild['cacheFile'] !== null) {
+                if (file_exists($finishedChild['cacheFile']) === true) {
+                    $this->mergeChildCacheFile($finishedChild['cacheFile']);
+                    @unlink($finishedChild['cacheFile']);
+                }
+            }
+
+            // PHPCS exits with 1/2 when violations were found; only treat other codes as failure.
+            if ($exit !== 0 && $exit !== 1 && $exit !== 2) {
+                $success = false;
+                if ($stderr !== '') {
+                    fwrite(STDERR, $stderr);
+                }
+            }
+
+            foreach ($finishedChild['files'] as $filePath) {
+                $numProcessed++;
+
+                $counts = [
+                    'errors'   => 0,
+                    'warnings' => 0,
+                    'fixable'  => 0,
+                    'fixed'    => 0,
+                ];
+                if (isset($fileCounts[$filePath]) === true) {
+                    $counts = $fileCounts[$filePath];
+                } else {
+                    $base = basename($filePath);
+                    foreach ($fileCounts as $reportPath => $reportCounts) {
+                        if (basename($reportPath) === $base) {
+                            $counts = $reportCounts;
+                            break;
+                        }
+                    }
+                }
+
+                $progressFile = new DummyFile($filePath, $this->ruleset, $this->config);
+                $progressFile->setErrorCounts($counts['errors'], $counts['warnings'], $counts['fixable'], $counts['fixed']);
+                $this->printProgress($progressFile, $numFiles, $numProcessed);
+            }
+        }
+
+        $this->reportSlowestBatches($children);
+
+        return $success;
+
+    }//end runWindowsParallel()
+
+
+    /**
+     * Print the slowest N parallel batches to STDERR for diagnostics.
+     *
+     * Enable by setting the PHPCS_BATCH_TIMING environment variable to a
+     * truthy value before invoking phpcs. Optionally override the number of
+     * batches reported via PHPCS_BATCH_TIMING_TOP (default 7).
+     *
+     * @param array<int, array<string, mixed>> $children Completed child batch records.
+     *
+     * @return void
+     */
+    private function reportSlowestBatches(array $children)
+    {
+        $flag = getenv('PHPCS_BATCH_TIMING');
+        if ($flag === false || $flag === '' || $flag === '0') {
+            return;
+        }
+
+        $top = (int) getenv('PHPCS_BATCH_TIMING_TOP');
+        if ($top <= 0) {
+            $top = 7;
+        }
+
+        usort(
+            $children,
+            function ($a, $b) {
+                return ($b['elapsed'] <=> $a['elapsed']);
+            }
+        );
+
+        $slice = array_slice($children, 0, $top);
+        fwrite(STDERR, PHP_EOL.sprintf('=== Slowest %d phpcs batches ===', count($slice)).PHP_EOL);
+        foreach ($slice as $rank => $batch) {
+            $elapsed = number_format((float) $batch['elapsed'], 3);
+            $count   = count($batch['files']);
+            fwrite(STDERR, sprintf('#%d  %ss  (%d files)', ($rank + 1), $elapsed, $count).PHP_EOL);
+            foreach ($batch['files'] as $path) {
+                fwrite(STDERR, '    '.$path.PHP_EOL);
+            }
+        }
+
+        fwrite(STDERR, PHP_EOL);
+
+    }//end reportSlowestBatches()
+
