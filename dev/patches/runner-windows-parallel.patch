+    /**
+     * Build the CLI argument list passed to each Windows child process.
+     *
+     * Strips file path positional arguments and any --parallel flag from the
+     * current invocation so the child receives the same flags but operates
+     * only on its assigned slice.
+     *
+     * @return array<int, string>
+     */
+    private function buildWindowsChildArgs()
+    {
+        $argv = [];
+        if (isset($_SERVER['argv']) === true && is_array($_SERVER['argv']) === true) {
+            $argv = $_SERVER['argv'];
+        }
+
+        array_shift($argv);
+        $out = [];
+        foreach ($argv as $arg) {
+            if (is_string($arg) === false || $arg === '') {
+                continue;
+            }
+
+            if (strncmp($arg, '--parallel', 10) === 0) {
+                continue;
+            }
+
+            if (strncmp($arg, '--cache', 7) === 0 || $arg === '--no-cache') {
+                continue;
+            }
+
+            // These are set explicitly per-child; passing the parent's
+            // versions through would conflict and corrupt the JSON report.
+            if (strncmp($arg, '--report', 8) === 0
+                || strncmp($arg, '--file-list', 11) === 0
+                || strncmp($arg, '--stdin-path', 12) === 0
+                || $arg === '-p'
+                || $arg === '--progress'
+            ) {
+                continue;
+            }
+
+            if (strncmp($arg, '-', 1) !== 0 && @file_exists($arg) === true) {
+                continue;
+            }
+
+            $out[] = $arg;
+        }
+
+        return $out;
+
+    }//end buildWindowsChildArgs()
+
+
+    /**
+     * Merge a child JSON report into the parent Reporter.
+     *
+     * Replays each child violation against a DummyFile and routes it through
+     * Reporter::cacheFileReport so every configured report format receives
+     * the data exactly as if the parent had processed the file itself.
+     *
+     * @param array<string, mixed> $json       Decoded JSON report from a child phpcs invocation.
+     * @param array<int, string>   $batchFiles The file paths assigned to the child, used to
+     *                                         restore the pre-basepath-stripped path.
+     *
+     * @return void
+     */
+    private function mergeChildJsonReport(array $json, array $batchFiles)
+    {
+        if (isset($json['files']) === false || is_array($json['files']) === false) {
+            return;
+        }
+
+        foreach ($json['files'] as $path => $info) {
+            if (is_array($info) === false) {
+                continue;
+            }
+
+            $path = $this->resolveChildReportPath((string) $path, $batchFiles);
+
+            // Anonymous DummyFile that exposes the protected addMessage() so
+            // child violations keep their original line and column. addError()
+            // /addWarning() derive the position from a token pointer, so passing
+            // null collapses every violation onto line 1. Mirrors
+            // LocalFile::replayErrors().
+            $dummy = new class('phpcs_input_file: '.$path."\n", $this->ruleset, $this->config) extends DummyFile {
+
+
+                /**
+                 * Replay child-reported violations at their original position.
+                 *
+                 * @param array<int, array<string, mixed>> $messages Decoded JSON report messages for one file.
+                 *
+                 * @return void
+                 */
+                public function replayMessages(array $messages)
+                {
+                    $this->replayingErrors = true;
+                    foreach ($messages as $msg) {
+                        if (is_array($msg) === false) {
+                            continue;
+                        }
+
+                        $type = isset($msg['type']) ? (string) $msg['type'] : 'ERROR';
+                        $this->addMessage(
+                            ($type !== 'WARNING'),
+                            isset($msg['message']) ? (string) $msg['message'] : '',
+                            isset($msg['line']) ? (int) $msg['line'] : 1,
+                            isset($msg['column']) ? (int) $msg['column'] : 1,
+                            (isset($msg['source']) === true && $msg['source'] !== '') ? (string) $msg['source'] : 'Internal.Unknown',
+                            [],
+                            isset($msg['severity']) ? (int) $msg['severity'] : 5,
+                            isset($msg['fixable']) ? (bool) $msg['fixable'] : false
+                        );
+                    }
+
+                    $this->replayingErrors = false;
+
+                }//end replayMessages()
+
+
+            };
+
+            $messages = (isset($info['messages']) === true && is_array($info['messages']) === true) ? $info['messages'] : [];
+            $dummy->replayMessages($messages);
+
+            $this->reporter->cacheFileReport($dummy);
+        }
+
+    }//end mergeChildJsonReport()
+
+
+    /**
+     * Merge a child's raw Cbf report data into the parent Reporter.
+     *
+     * PHPCBF forces its report set to "cbf", so a child cannot produce the JSON
+     * report the PHPCS path relies on. Instead the child writes the intermediate
+     * Cbf data - one `filename>>errors>>warnings>>fixable>>fixed` line per fixed
+     * file - plus a sidecar file holding its run totals. Both are folded into the
+     * parent so the final summary matches a serial run.
+     *
+     * @param string             $raw        Raw Cbf report data written by the child.
+     * @param string             $totalsFile Path to the sidecar file holding the child's totals.
+     * @param array<int, string> $batchFiles The file paths assigned to the child.
+     *
+     * @return array<string, array<string, int>> Per-file counts keyed by dispatched path.
+     */
+    private function mergeChildCbfReport($raw, $totalsFile, array $batchFiles)
+    {
+        $fileCounts = [];
+
+        if ($raw !== '') {
+            $this->appendCbfReportData($raw);
+
+            foreach (explode(PHP_EOL, $raw) as $line) {
+                if ($line === '') {
+                    continue;
+                }
+
+                $parts = explode('>>', $line);
+                if (count($parts) < 5) {
+                    continue;
+                }
+
+                $resolved = $this->resolveChildReportPath($parts[0], $batchFiles);
+                $fileCounts[$resolved] = [
+                    'errors'   => (int) $parts[1],
+                    'warnings' => (int) $parts[2],
+                    'fixable'  => (int) $parts[3],
+                    'fixed'    => (int) $parts[4],
+                ];
+            }
+        }
+
+        if (file_exists($totalsFile) === true) {
+            $totalsRaw = file_get_contents($totalsFile);
+            @unlink($totalsFile);
+            $totals = ($totalsRaw === false || $totalsRaw === '') ? null : json_decode($totalsRaw, true);
+            if (is_array($totals) === true) {
+                $this->reporter->totalFiles    += (isset($totals['totalFiles']) === true ? (int) $totals['totalFiles'] : 0);
+                $this->reporter->totalErrors   += (isset($totals['totalErrors']) === true ? (int) $totals['totalErrors'] : 0);
+                $this->reporter->totalWarnings += (isset($totals['totalWarnings']) === true ? (int) $totals['totalWarnings'] : 0);
+                $this->reporter->totalFixable  += (isset($totals['totalFixable']) === true ? (int) $totals['totalFixable'] : 0);
+                $this->reporter->totalFixed    += (isset($totals['totalFixed']) === true ? (int) $totals['totalFixed'] : 0);
+            }
+        }
+
+        return $fileCounts;
+
+    }//end mergeChildCbfReport()
+
+
+    /**
+     * Append raw Cbf report data to the parent Reporter's report cache.
+     *
+     * Reporter builds the final PHPCBF summary from the intermediate data each
+     * report accumulates during the run. That store is private, so reflection is
+     * required to append the data produced by a child process to it.
+     *
+     * @param string $data Raw Cbf report data written by a child process.
+     *
+     * @return void
+     */
+    private function appendCbfReportData($data)
+    {
+        try {
+            $ref         = new \ReflectionClass($this->reporter);
+            $reportsProp = $ref->getProperty('reports');
+            $tmpProp     = $ref->getProperty('tmpFiles');
+            if (PHP_VERSION_ID < 80100) {
+                $reportsProp->setAccessible(true);
+                $tmpProp->setAccessible(true);
+            }
+
+            $reports  = $reportsProp->getValue($this->reporter);
+            $tmpFiles = $tmpProp->getValue($this->reporter);
+        } catch (\ReflectionException $e) {
+            return;
+        }
+
+        if (is_array($reports) === false || isset($reports['cbf']) === false) {
+            return;
+        }
+
+        $target = $reports['cbf']['output'];
+        if ($target === null) {
+            $target = (isset($tmpFiles['cbf']) === true) ? $tmpFiles['cbf'] : null;
+        }
+
+        if ($target === null) {
+            return;
+        }
+
+        file_put_contents($target, $data, (FILE_APPEND | LOCK_EX));
+
+    }//end appendCbfReportData()
+
+
+    /**
+     * Map a path from a child JSON report back to the path the parent dispatched.
+     *
+     * Children run the same config as the parent, so their report paths have
+     * already had --basepath stripped. Replaying those shortened paths breaks
+     * File::addMessage(), which matches a sniff's include/exclude patterns
+     * against the file path and silently discards every message when a
+     * pattern such as `*<slash>core/*` can no longer match. Restoring the
+     * original path keeps that matching consistent with the child.
+     *
+     * @param string             $reportPath Path as reported by the child.
+     * @param array<int, string> $batchFiles The file paths assigned to the child.
+     *
+     * @return string
+     */
+    private function resolveChildReportPath($reportPath, array $batchFiles)
+    {
+        $basepath = $this->config->basepath;
+        $needle   = strtolower(str_replace('/', DIRECTORY_SEPARATOR, $reportPath));
+        $basename = strtolower(basename($reportPath));
+        $suffix   = null;
+        $fallback = null;
+
+        foreach ($batchFiles as $filePath) {
+            $candidate = strtolower(str_replace('/', DIRECTORY_SEPARATOR, $filePath));
+            if ($candidate === $needle
+                || strtolower(str_replace('/', DIRECTORY_SEPARATOR, Common::stripBasepath($filePath, $basepath))) === $needle
+            ) {
+                return $filePath;
+            }
+
+            if ($suffix === null && substr($candidate, -(strlen($needle) + 1)) === DIRECTORY_SEPARATOR.$needle) {
+                $suffix = $filePath;
+            }
+
+            if ($fallback === null && strtolower(basename($filePath)) === $basename) {
+                $fallback = $filePath;
+            }
+        }
+
+        if ($suffix !== null) {
+            return $suffix;
+        }
+
+        return ($fallback === null) ? $reportPath : $fallback;
+
+    }//end resolveChildReportPath()
+
+
+    /**
+     * Read the parent's resolved cache file contents (raw JSON) if present.
+     *
+     * Each child is seeded with this content so cache hits from previous
+     * runs are preserved across the proc_open boundary. The parent's
+     * \PHP_CodeSniffer\Util\Cache class stores the resolved path in a
+     * private static property, so reflection is required to read it.
+     *
+     * @return string|null Raw cache file contents, or null when no cache file exists.
+     */
+    private function readParentCacheFile()
+    {
+        try {
+            $ref  = new \ReflectionClass(\PHP_CodeSniffer\Util\Cache::class);
+            $prop = $ref->getProperty('path');
+            if (PHP_VERSION_ID < 80100) {
+                $prop->setAccessible(true);
+            }
+
+            $path = (string) $prop->getValue();
+        } catch (\ReflectionException $e) {
+            return null;
+        }
+
+        if ($path === '' || file_exists($path) === false) {
+            return null;
+        }
+
+        $contents = file_get_contents($path);
+        return ($contents === false) ? null : $contents;
+
+    }//end readParentCacheFile()
+
+
+    /**
+     * Merge a child's cache file entries into the parent's in-memory cache.
+     *
+     * The parent's Runner::run() calls Cache::save() once after all batches
+     * complete, so populating the in-memory cache here is sufficient to
+     * persist the merged result.
+     *
+     * @param string $cacheFile Absolute path to the child's per-shard cache file.
+     *
+     * @return void
+     */
+    private function mergeChildCacheFile($cacheFile)
+    {
+        $raw = file_get_contents($cacheFile);
+        if ($raw === false || $raw === '') {
+            return;
+        }
+
+        $data = json_decode($raw, true);
+        if (is_array($data) === false) {
+            return;
+        }
+
+        foreach ($data as $key => $value) {
+            if ($key === 'config') {
+                continue;
+            }
+
+            \PHP_CodeSniffer\Util\Cache::set($key, $value);
+        }
+
+    }//end mergeChildCacheFile()
+
+
 }//end class
